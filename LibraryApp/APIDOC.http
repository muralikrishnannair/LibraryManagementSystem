###
POST http://127.0.0.1:8000/books/
Content-Type: application/json

{
    "title":"Python Programming",
    "author":"John Smith",
    "category":"Programming",
    "price":450,
    "quantity":5,
    "is_available":true,
    "published_date":"2025-01-15"
}

#get all books
###
GET http://127.0.0.1:8000/books/

#get one book
###
GET http://127.0.0.1:8000/book/1/

#update

###
PUT http://127.0.0.1:8000/book/1/
Content-Type: application/json

{
    "title":"Python Programming Basics",
    "author":"John Smith",
    "category":"Programming",
    "price":500,
    "quantity":5,
    "is_available":true,
    "published_date":"2025-01-15"
}
#issue a book
###
PUT http://127.0.0.1:8000/book/1/issue/
Content-Type: application/json

#return a book
###
PUT http://127.0.0.1:8000/book/1/return/
Content-Type: application/json

#delete
###
DELETE http://127.0.0.1:8000/book/1/